{
    "hosting": {
        "site": "babutv",
        "public": "dist",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "rewrites": [
            {
                "source": "/upload",
                "destination": "/upload/index.html"
            },
            {
                "source": "/upload/**",
                "destination": "/upload/index.html"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ],
        "headers": [
            {
                "source": "/assets/**",
                "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
            },
            {
                "source": "**/*.html",
                "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
            }
        ]
    }
}
